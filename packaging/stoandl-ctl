#!/bin/sh
# `stoandl` CLI: the stoandl fat JAR in ctl mode. The one launcher: install.sh copies it, the APKBUILD
# installs it with its JDK 25 path and JAR location.
#
# A CLI call is short-lived, so the JVM is set up to start fast (about 470 → 270 ms for `watch list` on
# x86):
# - C1 only, Serial GC, and no hsperfdata file in /tmp.
# - a CDS archive of the classes the CLI loads (on top of the JDK's own classes.jsa). It holds what the
#   run that wrote it loaded, so the first call after an install or upgrade first runs a hidden
#   `stoandl version` (D-Bus connect and call, the start every command shares) with
#   -XX:+AutoCreateSharedArchive (JDK 19+). Only that seed writes: it dumps to a name of its own and the
#   file is moved into place only when the dump worked, because a failed dump (a full disk) makes the JVM
#   exit 1 after its command ran. Commands only read the archive (-XX:SharedArchiveFile, -Xshare:auto),
#   and the JVM skips an unusable one silently. The JVM does not rewrite the archive when the JAR changes,
#   it just stops using it, so the file name carries the JAR's size and mtime, and those of the JDK's
#   lib/modules (an archive from another JVM build is refused too): an upgrade of either seeds a new
#   archive and drops the old one. A seed that wrote nothing (no base CDS archive in this JDK, CDS off,
#   a full disk) leaves a `.nocds` marker, so commands don't run a seed each time; the next JAR retries.
#   -Xlog:cds/aot=off: the JVM prints CDS warnings on stdout.
# No --enable-native-access (the JAR's manifest grants it) and no --add-opens (only the daemon's
# BecomeMonitor reflection needed those, and on the classpath dbus-java is in the unnamed module anyway).
java=java
jar=/usr/lib/stoandl/stoandl.jar
set -- -jar "$jar" ctl "$@"
cds=${XDG_CACHE_HOME:-$HOME/.cache}/stoandl
if id=$(stat -c %s-%Y "$jar" 2>/dev/null) && mkdir -p "$cds" 2>/dev/null && [ -w "$cds" ]; then
    jdk=$(readlink -f "$(command -v "$java")" 2>/dev/null)
    id=$id-$(stat -c %s-%Y "${jdk%/bin/*}/lib/modules" 2>/dev/null || echo 0)
    jsa="$cds/cli-$id.jsa"
    if [ ! -f "$jsa" ] && [ ! -f "$cds/cli-$id.nocds" ]; then
        # Another JAR's files go; a parallel first run's seed (cli-$id.jsa.<pid>) stays.
        for f in "$cds"/cli-*; do
            case $f in "$cds/cli-$id".*) ;; *) rm -f "$f" ;; esac
        done
        if "$java" -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -XX:-UsePerfData \
            -XX:+AutoCreateSharedArchive "-XX:SharedArchiveFile=$jsa.$$" -Xlog:cds=off -Xlog:aot=off \
            -jar "$jar" ctl version > /dev/null 2>&1 < /dev/null && mv -f "$jsa.$$" "$jsa" 2>/dev/null; then
            :
        else
            rm -f "$jsa.$$"
            : > "$cds/cli-$id.nocds"
        fi
    fi
    [ -f "$jsa" ] && set -- "-XX:SharedArchiveFile=$jsa" -Xlog:cds=off -Xlog:aot=off "$@"
fi
exec "$java" -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -XX:-UsePerfData "$@"
